# Template file for 'claude-desktop'
pkgname=claude-desktop
version=1.32885.1
_release=3.2.2
revision=1
archs="x86_64"
wrksrc="claude-desktop-${version}"
depends="alsa-lib libsecret libgbm libdrm libcups eudev-libudev
 libayatana-appindicator hicolor-icon-theme xdg-utils"
short_desc="Claude Desktop native Linux client for Claude AI"
maintainer="cybarchitect <cybarchitect@gmail.com>"
license="custom:Anthropic-TOS"
homepage="https://github.com/aaddrick/claude-desktop-debian"
distfiles="https://github.com/aaddrick/claude-desktop-debian/releases/download/v3.2.2%2Bclaude1.32885.1/claude-desktop-unofficial-1.32885.1-3.2.2-amd64.AppImage"
checksum=ecde0af672e45b363f16bcba17bc22050bbaa402af36a97cdfdf61417a32a988
nostrip=yes
noshlibs=yes

do_extract() {
    local appimage="${XBPS_SRCDISTDIR}/${pkgname}-${version}/claude-desktop-unofficial-${version}-${_release}-amd64.AppImage"
    chmod +x "${appimage}"
    "${appimage}" --appimage-extract
    mkdir -p ${wrksrc}
    cp -aL squashfs-root/. ${wrksrc}/
    rm -rf squashfs-root
}

do_install() {
    vinstall io.github.aaddrick.claude-desktop-debian.png 644 \
        usr/share/icons/hicolor/256x256/apps claude-desktop.png
    vinstall io.github.aaddrick.claude-desktop-debian.png 644 \
        usr/share/pixmaps claude-desktop.png
    vinstall ${FILESDIR}/claude-desktop.desktop 644 usr/share/applications

    vmkdir opt/claude-desktop
    vcopy "*" opt/claude-desktop

    vmkdir usr/bin
    ln -sf /opt/claude-desktop/AppRun ${DESTDIR}/usr/bin/claude-desktop

    chmod -R o-w ${DESTDIR}/opt/claude-desktop
    chmod 755 ${DESTDIR}/opt/claude-desktop/AppRun

    local electron="${DESTDIR}/opt/claude-desktop/usr/lib/claude-desktop/electron"
    if [ -f "${electron}" ]; then
        chmod 755 "${electron}"
    fi

    local sandbox="${DESTDIR}/opt/claude-desktop/usr/lib/claude-desktop/chrome-sandbox"
    if [ -f "${sandbox}" ]; then
        chmod 4755 "${sandbox}"
    fi
}

